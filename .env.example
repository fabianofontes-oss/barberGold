# ============================================
# BARBEGOLD - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env.local e preencha os valores

# ============================================
# SUPABASE (OBRIGATÓRIAS)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Service Role Key - apenas para operações de admin/webhooks (opcional em dev)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ============================================
# MODO DA APLICAÇÃO
# ============================================
# demo = Dados mockados locais (sem Supabase)
# pilot = Supabase real, funcionalidades limitadas
# prod = Produção completa
NEXT_PUBLIC_APP_MODE=demo

# ============================================
# STRIPE (OPCIONAL - apenas para pagamentos)
# ============================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# SITE URL (OPCIONAL)
# ============================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
